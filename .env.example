# ==============================================================================
# ENVIRONMENT VARIABLES TEMPLATE
# Uso: Crear una copia de este archivo, renombrarla a '.env' y ajustar los 
# valores según el entorno (Local, Staging, Producción).
# ==============================================================================

# --- Database Configuration (MySQL) ---
# Contraseña para el usuario root del contenedor local de MySQL
MYSQL_ROOT_PASSWORD=root

# --- Security & Authentication ---
# REEMPLAZAR POR TU PROPIA CLAVE. 
# Importante: Spring Security requiere que la clave tenga un mínimo de 32 caracteres.
JWT_SECRET=coloca_aqui_tu_clave_secreta_de_al_menos_32_caracteres_para_jwt

# Tiempo de vida útil del token JWT expresado en milisegundos (900000ms = 15 minutos)
JWT_EXPIRATION=900000